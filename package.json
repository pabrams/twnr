{
  "private": true,
  "type": "module",
  "scripts": {
    "delete:buildinfo": "find . -name '*.tsbuildinfo' -delete",
    "delete:dist": "find . -name 'dist' -type d -exec rm -rf {} +",
    "delete:nm": "find . -name node_modules -type d -prune -exec rm -rf {} +",
    "clean:install": "pnpm delete:dist && pnpm delete:buildinfo && pnpm delete:nm",
    "clean:build": "pnpm delete:buildinfo && pnpm delete:dist",
    "rebuild": "pnpm clean && pnpm build",
    "dev": "pnpm --parallel --filter @twnr/server --filter @twnr/client run dev",
    "build": "pnpm -r run build && pnpm run docs",
    "test": "pnpm lint && pnpm format:check && pnpm run docs && pnpm -r --no-bail run test",
    "cli": "node packages/cli/dist/index.js",
    "start": "pnpm --filter @twnr/server start",
    "db:seed": "pnpm --filter @twnr/server db:seed",
    "db:reseed": "pnpm --filter @twnr/server db:reseed",
    "db:import": "pnpm --filter @twnr/server db:import",
    "db:drop": "pnpm --filter @twnr/server dropDatabase",
    "bigbang": "pnpm --filter @twnr/server bigbang",
    "generate-env": "pnpm --filter @twnr/server generate-env",
    "lint": "eslint packages/*/src",
    "format": "prettier --write \"packages/*/src/**/*.ts\"",
    "format:check": "prettier --check \"packages/*/src/**/*.ts\"",
    "preview:messages": "tsx scripts/preview-messages.ts",
    "preview:messages:watch": "tsx watch scripts/preview-messages.ts",
    "preview:msg:watch": "tsx watch scripts/preview-messages.ts MSG",
    "preview:common:watch": "tsx watch scripts/preview-messages.ts COMMON",
    "preview:sector:watch": "tsx watch scripts/preview-messages.ts SECTOR",
    "preview:help:watch": "tsx watch scripts/preview-messages.ts HELP",
    "preview:port:watch": "tsx watch scripts/preview-messages.ts PORT",
    "preview:planet:watch": "tsx watch scripts/preview-messages.ts PLANET",
    "preview:starbase:watch": "tsx watch scripts/preview-messages.ts STARBASE",
    "preview:computer:watch": "tsx watch scripts/preview-messages.ts COMPUTER",
    "preview:combat:watch": "tsx watch scripts/preview-messages.ts COMBAT",
    "preview:notify:watch": "tsx watch scripts/preview-messages.ts NOTIFY",
    "preview:transaction:watch": "tsx watch scripts/preview-messages.ts TRANSACTION",
    "preview:event:watch": "tsx watch scripts/preview-messages.ts EVENT",
    "preview:panel:watch": "tsx watch scripts/preview-messages.ts PANEL",
    "docs": "ts-json-schema-generator --path packages/shared/src/client-messages.ts --type ClientCommand -o docs/client-messages.schema.json && ts-json-schema-generator --path packages/shared/src/server-messages.ts --type ServerResult -o docs/server-messages.schema.json && node scripts/generate-docs.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^10.1.0",
    "eslint-plugin-n": "^17.24.0",
    "prettier": "^3.8.1",
    "ts-json-schema-generator": "^2.9.0",
    "tsx": "^4.21.0"
  }
}
