{
  "name": "@twnr/server",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/server.js",
  "exports": {
    ".": {
      "import": "./dist/server.js"
    }
  },
  "dependencies": {
    "@twnr/shared": "workspace:*",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.20.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^6.0.2",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.0",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "build": "tsc",
    "generate-env": "node scripts/generate-env.mjs",
    "dev": "node --env-file=.env --watch ./dist/server.js",
    "start": "node --env-file=.env ./dist/server.js",
    "kill:dev": "fuser -k ${PORT:-3000}/tcp >/dev/null 2>&1; true",
    "clean:universe": "rm -rf data/universe",
    "dropDatabase": "pnpm run kill:dev && node --env-file=.env ./scripts/deleteDatabase.js",
    "bigbang": "node ./scripts/twnr-bigbang.js data/universe/",
    "db:import": "pnpm run kill:dev && node --env-file=.env ./scripts/importUniverse.js",
    "db:seed": "pnpm run kill:dev && node ./scripts/twnr-bigbang.js ./data/universe/ --sectors 2000 --seed 42 && node --env-file=.env ./scripts/importUniverse.js ./data/universe --force",
    "db:reseed": "pnpm run dropDatabase && pnpm run clean:universe && pnpm run db:seed",
    "db:addTestData1": "node --env-file=.env ./scripts/addTestData1.js",
    "test": "bash test/run-tests.sh"
  }
}
