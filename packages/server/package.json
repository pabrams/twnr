{
  "name": "@twnr/server",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/server.js",
  "exports": {
    ".": {
      "import": "./dist/server.js"
    }
  },
  "dependencies": {
    "@twnr/shared": "workspace:*",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.20.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^6.0.2",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.0",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "build": "tsc",
    "generate-env": "node scripts/generate-env.mjs",
    "start": "node --env-file=.env ./dist/server.js",
    "dropDatabase": "node ./scripts/deleteDatabase.js",
    "bigbang": "node ./scripts/twnr-bigbang.js data/universe/",
    "db:import": "node ./scripts/importUniverse.js",
    "db:seed": "node ./scripts/twnr-bigbang.js ./data/universe/ --sectors 100 --seed 42 && node ./scripts/importUniverse.js ./data/universe --force"
  }
}
